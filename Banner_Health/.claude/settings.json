{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-phi.sh \"${file_path}\" \"${content}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/audit-log.sh \"${tool_name}\" \"${file_path}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
